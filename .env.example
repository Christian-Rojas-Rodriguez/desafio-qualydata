# Copiar a .env (ignorado por git) y completar. Todas son opcionales:
# sin claves, el pipeline corre igual sin LLM.

# Proveedor de LLM para nombrar narrativas y desempatar casos dudosos:
#   none | anthropic | mlx (local en Apple Silicon)
QD_LLM=none

# Solo si QD_LLM=anthropic
ANTHROPIC_API_KEY=

# Kaggle: preferir ~/.kaggle/access_token (fuera del repo). Solo si se usa por env:
KAGGLE_API_TOKEN=
